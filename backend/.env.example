# Prius Price Tracker Configuration
# Copy this to .env and adjust as needed

# Vision model backend: "ollama" (local, free) or "openai" (paid fallback)
PRIUS_EXTRACTION_BACKEND=ollama
PRIUS_ANALYSIS_BACKEND=ollama

# Ollama settings
PRIUS_OLLAMA_BASE_URL=http://localhost:11434
PRIUS_OLLAMA_MODEL=qwen2.5vl:7b

# OpenAI settings (only needed if using openai backend)
PRIUS_OPENAI_API_KEY=
PRIUS_OPENAI_MODEL=gpt-4o

# Capture settings
PRIUS_CAPTURE_HOTKEY=<super>+<shift>+p
PRIUS_CAPTURE_MONITOR=0

# Debug mode (verbose logging, SQL echo)
PRIUS_DEBUG=true
